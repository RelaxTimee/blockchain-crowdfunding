{
  "name": "innovatefund-crowdfunding",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:sepolia": "node scripts/check-sepolia.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-thai": "^5.2.0",
    "@fontsource/space-grotesk": "^5.2.0",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.10.1",
    "solc": "^0.8.38",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.12"
  },
  "optionalDependencies": {
    "@foundry-rs/anvil-darwin-amd64": "1.7.1",
    "@foundry-rs/anvil-darwin-arm64": "1.7.1",
    "@foundry-rs/anvil-linux-amd64": "1.7.1",
    "@foundry-rs/anvil-linux-arm64": "1.7.1",
    "@foundry-rs/anvil-win32-amd64": "1.7.1"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
